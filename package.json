{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Invisiboll Browser web application — Laravel, Inertia, and React.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "vite build",
    "build:ssr": "vite build && vite build --ssr",
    "dev": "vite",
    "arch:frontend": "depcruise resources/js --config .dependency-cruiser.cjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write resources/ tests/ eslint.config.js playwright.config.ts components.json tsconfig.json .prettierrc.js",
    "format:check": "prettier --check resources/ tests/ eslint.config.js playwright.config.ts components.json tsconfig.json .prettierrc.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "types": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.php": [
      "vendor/bin/pint --dirty"
    ],
    "{resources,tests}/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.19.0",
    "@laravel/vite-plugin-wayfinder": "^0.1.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript-eslint": "^8.23.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@inertiajs/react": "^3.0.0",
    "@inertiajs/vite": "^3.0.0",
    "@laravel/passkeys": "^0.2.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "globals": "^15.14.0",
    "input-otp": "^1.4.2",
    "laravel-vite-plugin": "^3.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@rollup/rollup-win32-x64-msvc": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "lightningcss-win32-x64-msvc": "^1.29.1"
  }
}
