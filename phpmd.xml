<?xml version="1.0"?>
<ruleset name="Browser PHPMD rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 https://pmd.github.io/schema/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="https://pmd.github.io/schema/ruleset_xml_schema.xsd">
    <description>Baseline-safe quality and complexity gate for the Laravel application.</description>

    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="15" />
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="200" />
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="500" />
        </properties>
    </rule>

    <rule ref="rulesets/cleancode.xml/UndefinedVariable" />
    <rule ref="rulesets/cleancode.xml/DuplicatedArrayKey" />

    <rule ref="rulesets/design.xml/EvalExpression" />
    <rule ref="rulesets/design.xml/GotoStatement" />
</ruleset>
